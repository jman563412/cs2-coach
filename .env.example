# Copy to .env and fill in. .env is gitignored; never commit it.

# Leetify public API key: https://leetify.com/app/developer
LEETIFY_API_KEY=
# Steam Web API key (friend list / name lookups): https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your SteamID64 (17 digits, starts with 7656119). Every analysis is about this account.
CS2_STEAM_ID=
# IANA time zone your browser was in for the csstats.gg export, e.g. America/Chicago. Default: UTC.
CS2_TIMEZONE=

# Optional, only for Steam match-history lookups (CS2 settings > Match History > authentication code)
STEAM_MATCH_AUTH_CODE=
# Optional, the most recent match sharecode you've seen (starting point for that walk)
STEAM_LAST_SHARECODE=
